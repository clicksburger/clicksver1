# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo servidor (Server Components / Route Handlers / Server Actions).
# NUNCA exponer al cliente. Usado por el servidor para validar y registrar el checkout.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Super-admin de plataforma ────────────────────────────────
# Email del usuario (en auth.users) marcado como superadmin en la tabla platform_admins.
SUPERADMIN_EMAIL=admin@clicks.app

# WhatsApp de pedidos: país + área + número, sin signos ni espacios.
CLICKS_WHATSAPP_NUMBER=543518737099

# ── Envío por distancia ──────────────────────────────────────
# Google Cloud → APIs y servicios → habilitar "Geocoding API" → Credenciales → clave.
# Solo servidor (no lleva NEXT_PUBLIC_). Sin esta clave, los envíos quedan "a confirmar".
GOOGLE_MAPS_API_KEY=
